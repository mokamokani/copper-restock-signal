# Copy this file to `.env` for LOCAL email testing only.
# `.env` is git-ignored. In production the same five values are GitHub
# Actions repository secrets, never files in this repository.
#
# SMTP_PASS must be an APP PASSWORD / AUTHORISATION CODE, not your normal
# email login password. See README.md -> "Email alerts" for how to get one.

# Filled in for QQ mail; change the host/port if you use another provider.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_qq_number@qq.com
SMTP_PASS=16_character_authorisation_code
ALERT_TO=recipient@example.com

# Optional: only if your mail provider requires a different From address.
# ALERT_FROM=you@example.com
#
# Common providers:
#   QQ mail      smtp.qq.com        465 (SSL) or 587 (STARTTLS)
#   163 mail     smtp.163.com       465 (SSL) or 994 (SSL)
#   Gmail        smtp.gmail.com     465 (SSL) or 587 (STARTTLS)
#   Outlook      smtp.office365.com 587 (STARTTLS)
#
# Quick local check: python scripts/daily_report.py --test-email
# Dry run (no network): python scripts/daily_report.py --test-email --dry-run-email
